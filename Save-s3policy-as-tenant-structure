# =========================
# LOGIN
# =========================

def login(account_id):

    url = BASE_URL + "/api/v4/authorize"

    payload = {
        "accountId": account_id,
        "username": USERNAME,
        "password": PASSWORD,
        "cookie": True,
        "csrfToken": False
    }

    res = requests.post(url, json=payload, verify=False)

    if res.status_code != 200:
        print("❌ Login Failed")
        print(res.text)
        sys.exit(1)

    print("✅ Login Success")

    return res.json()["data"]

# =========================
# GET ALL IDM GROUPS
# =========================

def get_all_groups(token):

    url = BASE_URL + "/api/v4/org/groups"

    headers = {
        "Authorization": f"Bearer {token}"
    }

    res = requests.get(url, headers=headers, verify=False)

    if res.status_code != 200:
        print("❌ Failed to fetch groups")
        print(res.text)
        sys.exit(1)

    return res.json().get("data", [])

# =========================
# GET GROUP S3 POLICY
# =========================

def get_group_policy(token, group_id):

    url = f"{BASE_URL}/api/v4/org/groups/{group_id}"

    headers = {
        "Authorization": f"Bearer {token}"
    }

    res = requests.get(url, headers=headers, verify=False)

    if res.status_code != 200:
        print(f"X Failed to fetch policy for group: {group_id}")
        print(res.text)
        return {}

    data = res.json().get("data", {})

   # print("\n===== GROUP DATA =====\n")
    #print(json.dumps(data, indent=4))

    return data

# =========================
# CREATE BACKUP
# =========================

def backup_policies(token, account_name):

    groups = get_all_groups(token)

    if not groups:
        print("❌ No groups found")
        return

    # Create Account Folder
    os.makedirs(account_name, exist_ok=True)

    for group in groups:

        group_name = group.get("uniqueName", "unknown_group")
        group_id = group.get("id")

        print(f"\n📂 Processing Group: {group_name}")

        # Safe Folder Name
        safe_group_name = (
            group_name
            .replace("/", "_")
            .replace("\\", "_")
            .replace(" ", "_")
        )

        # Create Group Folder
        group_folder = os.path.join(account_name, safe_group_name)

        os.makedirs(group_folder, exist_ok=True)

        # Fetch Policy
        policy_data = get_group_policy(token, group_id)

        #Print Policy
       # print("\n S3 POLICY :\n")
        #print(json.dumps(policy_data, indent=4))

        # Backup File
        backup_file = os.path.join(group_folder, "s3_policy.txt")

        with open(backup_file, "w") as f:
            f.write(json.dumps(policy_data, indent=4))

        print(f"✅ Backup Saved: {backup_file}")

# =========================
# MAIN
# =========================

def main():

    if len(sys.argv) != 3:
        print("\nUsage:")
        print("python backup.py <ACCOUNT_ID> <ACCOUNT_NAME>")
        sys.exit(1)

    account_id = sys.argv[1]
    account_name = sys.argv[2]

    token = login(account_id)

    backup_policies(token, account_name)

    print("\n🎉 S3 Policy Backup Completed")

if __name__ == "__main__":
    main()





